# PostgreSQL (local: usa docker-compose.yml incluido)
DATABASE_URL="postgresql://eddoe:eddoe@localhost:5432/eddoe?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="reemplaza-esto-con-una-cadena-aleatoria-larga"

# Modo de aprobación de solicitudes: MANUAL | AUTOMATIC | INVITATION_ONLY
REGISTRATION_APPROVAL_MODE="MANUAL"

# Proveedor de IA por defecto: manual | gemini | openai
AI_DEFAULT_PROVIDER="manual"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Correo saliente (Fase 1: se registra en consola si no hay SMTP configurado)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="EDDOE <no-reply@eddoe.local>"

# Almacenamiento de evidencias (S3 compatible). Vacío = almacenamiento local temporal.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
